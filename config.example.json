{
  "server": { "host": "127.0.0.1", "port": 8756 },
  "analysis": {
    "interval_s": 240,
    "max_recommendations": 6,
    "max_probes": 2,
    "reconcile_every": 4,
    "final_sweep": true,
    "report": true,
    "default_duration_min": 60
  },
  "audio": {
    "sample_rate": 16000,
    "ring_seconds": 120,
    "poll_interval_s": 0.2,
    "max_chunk_s": 25.0,
    "min_pause_s": 0.7,
    "min_speech_s": 0.3,
    "pad_s": 0.2,
    "pre_pad_s": 0.3,
    "vad": "auto",
    "vad_positive_threshold": 0.5,
    "vad_negative_threshold": 0.35,
    "vad_min_speech_s": 0.25,
    "vad_redemption_s": 0.6,
    "watchdog_silence_s": 12.0
  },
  "asr": {
    "backend": "auto",
    "model": "large-v3-turbo",
    "mlx_model": "mlx-community/whisper-large-v3-turbo",
    "parakeet_model": "nemo-parakeet-tdt-0.6b-v3",
    "parakeet_quantization": "int8",
    "providers": ["CPUExecutionProvider"],
    "compute_type": "auto",
    "beam_size": 1,
    "language": null,
    "drop_no_speech_prob": 0.85
  },
  "llm": {
    "base_url": "http://127.0.0.1:11434",
    "model": "qwen3:8b",
    "num_ctx": 8192,
    "temperature": 0.2,
    "keep_alive": -1,
    "request_timeout_s": 300,
    "max_delta_chars": 12000
  },
  "storage": { "sessions_dir": "sessions", "guides_dir": "guides", "save_audio_chunks": false },
  "log_level": "INFO"
}
